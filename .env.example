# Runtime mode. Public builds must keep this value.
DATA_MODE=public-demo

# Optional read-only connector configuration (names only; never commit values).
GA4_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_MERCHANT_ID=
CLARITY_PROJECT_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Local API URL is used only by the non-static local application mode.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
